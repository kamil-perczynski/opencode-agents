{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "javadocs": {
      "enabled": true,
      "type": "remote",
      "url": "https://www.javadocs.dev/mcp"
    },
    "github": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,actions,users"
      },
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  },
  "agent": {
    "slack-bot": {
      "steps": 18,
      "permission": {
        "task": "deny"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "deny"
    },
    "doom_loop": "deny",
    "edit": {
      "*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.local/share/opencode/tool-output/*": "allow"
    },
    "glob": {
      "*": "deny"
    },
    "grep": {
      "*": "deny"
    },
    "list": {
      "*": "deny"
    },
    "read": {
      "*": "deny",
      "~/.local/share/opencode/tool-output/*": "allow"
    }
  }
}